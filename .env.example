# Copy to .env in the Replit workspace (QA). Never commit .env.
# QA database (Replit workspace). Production uses its own isolated DATABASE_URL secret.
DATABASE_URL=postgresql://user:password@localhost:5432/nflquiz

# Session signing secret. Set a long random string in production.
SESSION_SECRET=change-me-to-a-long-random-string

# Admin cold-start bootstrap (production secrets). Leave blank in QA and use seed.sql instead.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_USERNAME=
ADMIN_BOOTSTRAP_PASSWORD=
